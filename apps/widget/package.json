{
	"name": "@svar-ui/svelte-editor",
	"version": "2.7.0",
	"description": "SVAR UI ExportPopup board widget",
	"homepage": "https://svar.dev/svelte/editor/",
	"bugs": {
		"url": "https://forum.svar.dev"
	},
	"license": "SEE LICENSE IN license.txt",
	"repository": {
		"type": "git",
		"url": "https://github.com/svar-widgets/editor.git"
	},
	"files": [
		"dist",
		"readme.md",
		"license.txt"
	],
	"type": "module",
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"exports": {
		".": {
			"svelte": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vp test run",
		"build": "svelte-package -i ./src",
		"lint": "vp lint ./demos ./src",
		"start": "vp dev --open",
		"dev": "svelte-package -i ./src --watch"
	},
	"dependencies": {
		"@svar-ui/core-locales": "catalog:",
		"@svar-ui/editor-locales": "workspace:*",
		"@svar-ui/lib-dom": "catalog:",
		"@svar-ui/lib-state": "catalog:",
		"@svar-ui/svelte-core": "catalog:",
		"@svar-ui/svelte-toolbar": "catalog:",
		"svelte-check": "catalog:"
	},
	"devDependencies": {
		"@sveltejs/package": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"svelte": "catalog:"
	},
	"peerDependencies": {
		"svelte": "catalog:"
	}
}
